# Telegram
BOT_TOKEN=
# Username without @. Live getMe is preferred; this is only a fallback.
BOT_USERNAME=
# Comma-separated Telegram user IDs. These are not usernames.
ADMIN_IDS=
# Private group/channel where admin alerts are sent
ADMIN_NOTIFY_CHAT_ID=
PUBLIC_CHANNEL_ID=0
BACKUP_CHANNEL_ID=0

# NanoGPT — provider for the AI sections (programming/chat).
# OpenAI-compatible API; the model per section is set in the admin panel.
NANOGPT_API_KEY=
NANOGPT_BASE_URL=https://nano-gpt.com/api/v1

# WhatsApp bridge — the second bot's bridge service (📱 WhatsApp section).
# Run wa_bridge/bridge.py next to that bot (see BRIDGE_SETUP_GUIDE.md), then:
#   WA_BRIDGE_URL   internal URL only (http://wa-bridge:8090 or http://127.0.0.1:8090)
#   WA_BRIDGE_SECRET  must equal BRIDGE_SECRET of the bridge: openssl rand -hex 32
# Admin panel values (📱 إدارة واتساب ← 🔌 الجسر) override these two.
WA_BRIDGE_URL=
WA_BRIDGE_SECRET=

# SMS number providers (configure at least one for number sales)
FIVESIM_API_KEY=
HEROSMS_API_KEY=
SMS_ACTIVATE_API_KEY=
SMSHUB_API_KEY=
SMSPOOL_API_KEY=
GRIZZLY_API_KEY=

# ShamCash automatic payments (optional)
SAM_API_KEY=
SAM_API_WALLET_ADDRESS=
SAM_API_URL=https://www.sam-api.pro/api

# USDT automatic payments via Plisio (optional)
PLISIO_SECRET_KEY=
PLISIO_API_URL=https://api.plisio.net/api/v1
PLISIO_FEE_PERCENT=3.0
PLISIO_MIN_AMOUNT_USD=2.0
PLISIO_MAX_AMOUNT_USD=500.0
PLISIO_INVOICE_EXPIRE_MINUTES=30
PLISIO_POLLING_INTERVAL_SECONDS=30

# Manual USDT wallets
USDT_TRC20_ADDRESS=
USDT_ERC20_ADDRESS=
USDT_BEP20_ADDRESS=

# Manual ShamCash wallet
SHAMCASH_MANUAL_ADDRESS=
SHAMCASH_MANUAL_NAME=

# Database and optional persistent FSM storage
DATABASE_URL=sqlite+aiosqlite:///./bot_database.db
# Production example:
# DATABASE_URL=postgresql+asyncpg://bot:change_me@postgres:5432/botdb
# Example: redis://localhost:6379/0
REDIS_URL=
# Required only when using digital inventory products.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INVENTORY_ENCRYPTION_KEY=

# Telegram Mini App / API (optional; WEBAPP_URL must be HTTPS in production)
WEBAPP_URL=
ADMIN_WEBAPP_URL=
API_HOST=0.0.0.0
API_PORT=8080
SETUP_KEY=
SENTRY_DSN=
ENVIRONMENT=production

# Pricing and limits
DEFAULT_PROFIT_MARGIN_PERCENT=50
MIN_DEPOSIT_SHAMCASH_USD=0.5
MIN_DEPOSIT_USDT_USD=2
MIN_DEPOSIT_STARS_USD=1
DEFAULT_USD_TO_SYP_RATE=130
LARGE_TRANSACTION_THRESHOLD_USD=20
REFERRAL_BONUS_USD=0.015
REFERRAL_PERCENT=5
CASHBACK_PERCENT=0
LOYALTY_POINTS_PER_USD=10
LOYALTY_DAILY_POINTS=25
LOYALTY_POINTS_PER_USD_REDEEM=1000
LOYALTY_MIN_REDEEM_POINTS=100
STARS_RATE_USD=0.013
MAX_ACTIVE_ORDERS=3
RATE_LIMIT_SECONDS=30
GLOBAL_RATE_LIMIT_PER_MINUTE=60
CALLBACK_RATE_LIMIT_PER_MINUTE=120
API_RATE_LIMIT_PER_MINUTE=120
API_RATE_LIMIT_BURST=240
PROVIDER_LOW_BALANCE_THRESHOLD=10
LARGE_ORDER_CONFIRM_USD=20
ORDER_TIMEOUT_MINUTES=5

# General
REQUIRE_SUBSCRIPTION_FOR_REFERRAL=true
SUPPORT_USERNAME=@support
PAYMENT_METHOD_TEXT=

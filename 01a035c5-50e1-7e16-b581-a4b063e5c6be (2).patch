+                    NumberService(
+                        code=svc["code"],
+                        name_ar=svc["name_ar"],
+                        emoji=svc["emoji"],
+                        fivesim_code=svc["fivesim_code"],
+                        herosms_code=svc["herosms_code"],
+                        sms_activate_code=svc["sms_activate_code"],
+                        smshub_code=svc["smshub_code"],
+                        sort_order=svc["sort_order"],
+                        is_active=True,
+                    )
+                )
+
+        await session.commit()

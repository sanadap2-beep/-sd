+                {
+                    "action": "setStatus",
+                    "id": order_id,
+                    "status": 8,
+                }
+            )
+            return True
+        except Exception as e:
+            logger.error(f"فشل إلغاء الطلب {order_id} من HeroSMS: {e}")

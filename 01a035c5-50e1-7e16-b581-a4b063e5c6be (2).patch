+                    min_q=product.min_quantity,
+                    max_q=product.max_quantity,
+                )
+                + "\n\n"
+                + I18nService.t("send_link", language),
+            )
+            await state.update_data(product_id=product_id)
+            await state.set_state(SMMOrderStates.waiting_link)
+        else:

+            )
+        )
+
+    b.button(
+        text="❌ إلغاء الفاتورة",
+        callback_data=f"sc_cancel:{invoice_id}",
+    )
+    b.adjust(1)
+    return b.as_markup()
+
+
+# ══════════════ أزرار الفاتورة التلقائية - USDT ══════════════
+
+
+def usdt_auto_invoice_kb(
+    invoice_id: int,
+    payment_url: str | None = None,
+) -> InlineKeyboardMarkup:
+    """
+    أزرار الفاتورة التلقائية لـ USDT.

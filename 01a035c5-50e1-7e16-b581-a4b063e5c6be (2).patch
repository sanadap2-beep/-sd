+        f"🕐 آخر فحص: {last_check}\n"
+        f"🔄 آخر مزامنة: {last_sync}\n"
+    )
+
+    if provider.last_error:
+        text += f"\n⚠️ آخر خطأ: <code>{provider.last_error[:150]}</code>"
+
+    kb = provider_detail_kb(provider)
+
+    if edit:

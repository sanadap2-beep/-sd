+def _setup_is_valid(key: str) -> bool:
+    return bool(
+        settings.SETUP_KEY
+        and len(settings.SETUP_KEY) >= 32
+        and not settings.BOT_TOKEN
+        and not _setup_used
+        and hmac.compare_digest(key, settings.SETUP_KEY)

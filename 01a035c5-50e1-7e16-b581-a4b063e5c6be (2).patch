+<!doctype html>
+<html lang="ar" dir="rtl">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
+  <meta name="theme-color" content="#07111f">
+  <title>Number Bot Marketplace</title>
+  <link rel="stylesheet" href="/app/styles.css">
+  <script src="https://telegram.org/js/telegram-web-app.js"></script>
+</head>
+<body>
+  <main class="shell">
+    <section class="hero">
+      <div>
+        <span class="eyebrow">NUMBER BOT MARKETPLACE</span>
+        <h1>كل الخدمات الرقمية<br><strong>في مكان واحد</strong></h1>
+        <p>أرقام، ألعاب، SMM، اشتراكات وتراخيص رقمية بمزودين موثوقين.</p>
+      </div>
+      <div class="orb">✦</div>
+    </section>
+
+    <section class="account-card" id="account-card">
+      <div><span>رصيدك</span><strong id="balance">—</strong></div>
+      <div><span>نقاط الولاء</span><strong id="points">—</strong></div>
+      <div><span>المستوى</span><strong id="tier">—</strong></div>
+    </section>
+
+    <section class="toolbar">
+      <label class="search"><span>⌕</span><input id="search" type="search" placeholder="ابحث عن خدمة أو منتج..." autocomplete="off"></label>
+      <div class="cart-actions"><button class="cart-nav" id="cart-button">🛒 السلة</button><button class="cart-nav" id="checkout-cart">🧾 إتمام السلة</button></div>
+      <div class="chips" id="chips"><button class="chip active" data-filter="all">الكل</button></div>
+    </section>
+
+    <section id="message" class="message hidden"></section>
+    <section id="catalog" class="catalog"></section>
+    <section id="empty" class="empty hidden">
+      <div>◌</div><h2>لا توجد نتائج</h2><p>جرّب كلمة أخرى أو اطلب الخدمة من البوت.</p>
+    </section>
+  </main>
+  <script src="/app/app.js"></script>
+</body>
+</html>
diff --git a/webapp/styles.css b/webapp/styles.css
new file mode 100644
index 0000000..dea7d52
--- /dev/null
+++ b/webapp/styles.css
@@ -0,0 +1,65 @@
+:root {
+  color-scheme: dark;
+  --bg: #07111f;
+  --panel: rgba(18, 34, 56, .78);
+  --panel-strong: #122640;
+  --line: rgba(157, 190, 224, .16);
+  --text: #eff7ff;
+  --muted: #91a9c4;
+  --brand: #6ee7d2;
+  --brand-2: #7c9cff;
+  --danger: #ff879a;
+}
+* { box-sizing: border-box; }
+body {
+  margin: 0;
+  min-height: 100vh;
+  font-family: Tahoma, Arial, sans-serif;
+  color: var(--text);
+  background: radial-gradient(circle at 85% -10%, #214672 0, transparent 38%), var(--bg);
+}
+button, input { font: inherit; }
+.shell { max-width: 920px; margin: auto; padding: 18px 16px 42px; }
+.hero {
+  position: relative; overflow: hidden; display: flex; justify-content: space-between; align-items: center;
+  min-height: 220px; padding: 28px; border: 1px solid var(--line); border-radius: 30px;
+  background: linear-gradient(135deg, rgba(35, 75, 111, .9), rgba(13, 27, 48, .85));
+  box-shadow: 0 18px 60px rgba(0,0,0,.22);
+}
+.eyebrow { color: var(--brand); font-size: 11px; letter-spacing: 2px; font-weight: 700; }
+h1 { margin: 18px 0 8px; font-size: clamp(28px, 7vw, 52px); line-height: 1.15; }
+h1 strong { color: var(--brand); }
+.hero p { max-width: 510px; margin: 0; color: var(--muted); line-height: 1.8; }
+.orb { width: 100px; height: 100px; display: grid; place-items: center; border-radius: 50%; font-size: 44px; color: #07111f; background: linear-gradient(135deg, var(--brand), var(--brand-2)); box-shadow: 0 0 70px rgba(110,231,210,.42); }
+.account-card { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: 14px 0; }
+.account-card > div { padding: 16px; border: 1px solid var(--line); border-radius: 18px; background: var(--panel); backdrop-filter: blur(12px); }
+.account-card span { display: block; color: var(--muted); font-size: 12px; margin-bottom: 7px; }
+.account-card strong { font-size: 19px; }
+.toolbar { position: sticky; top: 8px; z-index: 2; padding: 10px 0; background: rgba(7,17,31,.84); backdrop-filter: blur(14px); }
+.search { display: flex; align-items: center; gap: 10px; padding: 0 15px; border: 1px solid var(--line); border-radius: 15px; background: var(--panel); }
+.search span { color: var(--brand); font-size: 26px; }
+.cart-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 9px; }
+.cart-nav { width: 100%; margin-top: 9px; padding: 11px; border: 1px solid var(--line); border-radius: 12px; color: var(--text); background: rgba(255,255,255,.04); cursor: pointer; }
+.search input { width: 100%; padding: 14px 0; color: var(--text); border: 0; outline: 0; background: transparent; }
+.chips { display: flex; gap: 8px; overflow-x: auto; padding: 10px 0 3px; }
+.chip { white-space: nowrap; padding: 9px 15px; border: 1px solid var(--line); border-radius: 99px; color: var(--muted); background: transparent; cursor: pointer; }
+.chip.active { color: #07111f; border-color: var(--brand); background: var(--brand); }
+.catalog { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 12px; }
+.category-title { grid-column: 1 / -1; margin: 18px 2px 0; color: var(--brand); font-size: 20px; }
+.product { display: flex; flex-direction: column; gap: 13px; padding: 18px; border: 1px solid var(--line); border-radius: 21px; background: linear-gradient(160deg, rgba(18,38,64,.92), rgba(10,24,43,.92)); }
+.product h3 { margin: 0; font-size: 17px; }
+.product p { min-height: 39px; margin: 0; color: var(--muted); font-size: 13px; line-height: 1.55; }
+.meta { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
+.price { color: var(--brand); font-size: 20px; font-weight: 800; }
+.old { margin-inline-start: 7px; color: var(--muted); font-size: 12px; text-decoration: line-through; }
+.rating { color: #ffd477; font-size: 12px; }
+.badge { align-self: flex-start; padding: 5px 9px; border-radius: 8px; color: #081623; background: var(--brand-2); font-size: 11px; font-weight: 700; }
+.buy, .cart, .watch { padding: 11px; border: 0; border-radius: 12px; cursor: pointer; }
+.cart { color: var(--text); border: 1px solid var(--line); background: rgba(124,156,255,.14); }
+.buy { color: #07111f; background: var(--brand); font-weight: 800; }
+.watch { color: var(--text); border: 1px solid var(--line); background: rgba(255,255,255,.04); }
+.message { margin: 14px 0; padding: 13px 15px; border-radius: 12px; color: var(--brand); background: rgba(110,231,210,.1); }
+.empty { padding: 60px 20px; text-align: center; color: var(--muted); }
+.empty div { color: var(--brand); font-size: 45px; }
+.hidden { display: none !important; }
+@media (max-width: 560px) { .hero { min-height: 190px; padding: 22px; } .orb { width: 64px; height: 64px; font-size: 28px; } .account-card strong { font-size: 15px; } }

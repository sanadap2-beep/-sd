+
+    await state.update_data(target=link)
+
+    if product.requires_quantity:
+        await message.answer(
+            f"📊 أرسل <b>الكمية</b> المطلوبة:\n"
+            f"الحد الأدنى: {product.min_quantity}\n"
+            f"الحد الأقصى: {product.max_quantity}"

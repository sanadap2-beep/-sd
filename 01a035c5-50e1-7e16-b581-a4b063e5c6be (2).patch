+
+    text += (
+        f"\n💰 <b>السعر عند المزود:</b>\n"
+        f"• {service.rate} {provider.currency} / 1000\n"
+        f"• {service.rate_usd}$ / 1000\n\n"
+        f"📊 <b>الكمية:</b>\n"
+        f"• الحد الأدنى: {service.min_quantity:,}\n"
+        f"• الحد الأقصى: {service.max_quantity:,}\n\n"
+        f"⚙️ <b>المتطلبات:</b>\n"
+    )
+    if service.requires_link:

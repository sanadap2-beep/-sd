+"""Rule-based instant support answers; private and deterministic by default."""
+
+from __future__ import annotations
+
+
+class AISupportService:
+    _answers = (
+        (
+            ("رصيد", "balance", "الرصيد"),
+            "يمكنك شحن الرصيد من زر 💰 شحن الرصيد، وستجد رصيدك الحالي داخل 👤 حسابي.",
+        ),
+        (
+            ("كود", "code", "الكود"),
+            "الطلبات المعلقة تُفحص تلقائياً. افتح طلبات الأرقام من حسابك وانتظر إشعار وصول الكود.",
+        ),
+        (
+            ("إيداع", "شحن", "deposit", "تحويل"),
+            "توجد طرق شحن يدوية وتلقائية. اختر الطريقة المناسبة، وتأكد من الشبكة والمبلغ قبل التحويل.",
+        ),
+        (
+            ("استرجاع", "refund", "رجع", "ارجاع"),
+            "عند فشل المزود أو انتهاء الطلب يُسترجع المبلغ تلقائياً، ويمكن للأدمن مراجعة الحالة من مركز الطلبات.",
+        ),
+        (
+            ("هدية", "gift", "بطاقة"),
+            "يمكن استبدال بطاقة الهدية من 🎁 بطاقة هدية. كل بطاقة تستخدم حسب الحد والصلاحية المحددين.",
+        ),
+        (
+            ("نقاط", "ولاء", "loyalty", "مكافأة"),
+            "اجمع النقاط من الشراء والتسجيل اليومي، ثم استبدلها برصيد من 🎁 الولاء والمكافآت.",
+        ),
+        (
+            ("مزود", "provider", "خدمة"),
+            "نختار المزود حسب توفر الخدمة ونراقب حالته. عند تعطل مزود، راجع 📡 حالة الخدمات أو افتح تذكرة.",
+        ),
+    )
+
+    @classmethod
+    def answer(cls, question: str) -> tuple[str, bool]:

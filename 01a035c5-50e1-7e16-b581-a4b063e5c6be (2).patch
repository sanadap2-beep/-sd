+        ]
+        text = "🏢 <b>المستأجرون</b>\n\n" + "\n".join(lines)
+    rows = [
+        [InlineKeyboardButton(text="➕ مستأجر جديد", callback_data="ops:tenantnew")],
+        [InlineKeyboardButton(text="⬅️ رجوع", callback_data="admin:ops")],

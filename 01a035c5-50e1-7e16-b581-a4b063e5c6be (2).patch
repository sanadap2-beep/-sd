+    await AuditService.log(
+        admin_id=db_user.id,
+        action=AuditAction.CREATE,
+        entity_type="tenant",
+        entity_id=result["tenant_id"],
+        entity_name=brand,
+        description="إنشاء مستأجر",
+        session=session,
